# Copy these variables into .env for local development or into Render Environment.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/gestionale_giardiniere?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
SPRING_FLYWAY_ENABLED=true
LOGGING_LEVEL_HIBERNATE_SQL=INFO
LOGGING_LEVEL_HIBERNATE_BIND=INFO
